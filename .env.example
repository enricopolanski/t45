# The local runner's OpenCode Go key; the runner doesn't start without it.
OPENCODE_API_KEY=
# The browser agents with Web browser drive, outside their VMs: a CDP WebSocket URL with the credential as user and
# password, e.g. Bright Data's Browser API at wss://USER:PASSWORD@brd.superproxy.io:9222. Unset, no agent gets one.
# WEB_BROWSER_URL=
