#!/bin/sh
# Reconcile packages after a branch checkout, in the main checkout or a linked
# worktree. The root prepare script points core.hooksPath here on
# `pnpm install`.
#
#   1. Drop TypeScript project emit (dist / tsbuildinfo) so composite/incremental
#      builds never typecheck against another branch's .d.ts.
#   2. Populate node_modules with `pnpm install --frozen-lockfile --prefer-offline`
#      against the shared store (hardlinks -> one inode per package file).
#
# pnpm decides whether the installed dependencies need updating.

# post-checkout also runs after file-only checkouts; those do not change packages.
[ "${3:-0}" = "1" ] || exit 0

wt_root=$(git rev-parse --show-toplevel 2>/dev/null)
[ -n "$wt_root" ] || exit 0

# --- TS build-cache wipe (every branch / worktree checkout) -----------------
#
# Composite/incremental emit (and leftover dist from builds) can outlive a
# branch switch. Foreign .tsbuildinfo / .d.ts produce phantom type errors that
# vanish after a clean rebuild — typescript-go incremental gaps (#2666, #4664,
# #4262).
# Workaround until upstream invalidation is solid; see .githooks/README.md.
#
clean_ts_project_emit() {
  root=$1
  removed=0

  for d in \
    "$root"/apps/*/dist \
    "$root"/packages/*/dist
  do
    [ -e "$d" ] || continue
    rm -rf "$d"
    removed=1
  done

  if [ -d "$root" ]; then
    # Prune by basename so nested apps/*/node_modules are skipped too.
    tsbuild_files=$(
      find "$root" \
        \( -name node_modules -o -name .git -o -name .vite-plus \) -prune -o \
        -type f -name '*.tsbuildinfo' -print 2>/dev/null || true
    )
    if [ -n "$tsbuild_files" ]; then
      printf '%s\n' "$tsbuild_files" | while IFS= read -r f; do
        [ -n "$f" ] || continue
        rm -f "$f"
      done
      removed=1
    fi
  fi

  if [ "$removed" = 1 ]; then
    echo "post-checkout: cleared TypeScript project emit (dist / tsbuildinfo) under $root" >&2
    echo "post-checkout: workaround for tsgo/tsc stale incremental cache after tree switch — see .githooks/README.md (remove when upstream fixed)" >&2
  fi
}

clean_ts_project_emit "$wt_root"

# Shared-store hardlink install: fast when the store is warm, no inode clone storm.
[ -f "$wt_root/package.json" ] || exit 0
[ -f "$wt_root/pnpm-lock.yaml" ] || {
  echo "post-checkout: package.json without pnpm-lock.yaml; skip install" >&2
  exit 0
}
command -v pnpm >/dev/null 2>&1 || {
  echo "post-checkout: pnpm not on PATH; node_modules not installed" >&2
  exit 0
}

export CI=1
echo "post-checkout: pnpm install (hardlink from store) in $wt_root" >&2
cd "$wt_root" || exit 1
if pnpm install \
    --frozen-lockfile \
    --prefer-offline \
    --config.package-import-method=hardlink \
    --config.confirmModulesPurge=false
then
  exit 0
else
  status=$?
  echo "post-checkout: dependency preparation failed (exit $status); worktree remains usable but degraded" >&2
  echo "post-checkout: fix the lockfile/configuration or rerun this hook after transient failures clear" >&2
  # Git invokes this hook inside `git worktree add`; dependency setup must not
  # turn an already-created worktree into a structural Git failure.
  exit 0
fi
