{
  "name": "@t45/runner",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/bin.ts",
    "start": "node src/bin.ts",
    "image": "sh image/build-local.sh",
    "typecheck": "tsc --noEmit && tsc --noEmit -p cloudflare",
    "cloudflare:dev": "wrangler dev",
    "cloudflare:deploy": "wrangler deploy",
    "cloudflare:types": "wrangler types cloudflare/worker-configuration.d.ts"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@opencode/client": "catalog:",
    "@opencode/protocol": "catalog:",
    "@opencode/schema": "catalog:",
    "@t45/contracts": "workspace:*",
    "effect": "catalog:",
    "microsandbox": "0.7.8"
  },
  "devDependencies": {
    "@cloudflare/sandbox": "1.0.3",
    "@types/node": "catalog:",
    "wrangler": "4.166.0"
  },
  "engines": {
    "node": "^24.21.0"
  }
}
